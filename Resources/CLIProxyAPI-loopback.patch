diff --git a/internal/loopback/listen.go b/internal/loopback/listen.go
new file mode 100644
index 0000000..76570a2
--- /dev/null
+++ b/internal/loopback/listen.go
@@ -0,0 +1,52 @@
+// Package loopback binds only addresses resolved for localhost and rejects any
+// non-loopback result before opening a socket.
+package loopback
+
+import (
+	"fmt"
+	"net"
+	"strconv"
+)
+
+// Listen opens a listener for each loopback address returned for localhost.
+// A port of zero selects one available port and binds every address to it.
+func Listen(port int) ([]net.Listener, error) {
+	addresses, err := net.LookupIP("localhost")
+	if err != nil {
+		return nil, fmt.Errorf("resolve localhost: %w", err)
+	}
+	if len(addresses) == 0 {
+		return nil, fmt.Errorf("localhost has no resolved addresses")
+	}
+	for _, address := range addresses {
+		if !address.IsLoopback() {
+			return nil, fmt.Errorf("localhost resolved to non-loopback address %s", address)
+		}
+	}
+	var listeners []net.Listener
+	selectedPort := port
+	for _, address := range addresses {
+		listener, listenErr := net.Listen("tcp", net.JoinHostPort(address.String(), strconv.Itoa(selectedPort)))
+		if listenErr != nil {
+			closeAll(listeners)
+			return nil, fmt.Errorf("listen on loopback %s:%d: %w", address, selectedPort, listenErr)
+		}
+		tcpAddress, ok := listener.Addr().(*net.TCPAddr)
+		if !ok || !tcpAddress.IP.IsLoopback() {
+			_ = listener.Close()
+			closeAll(listeners)
+			return nil, fmt.Errorf("listener address is not loopback")
+		}
+		if selectedPort == 0 {
+			selectedPort = tcpAddress.Port
+		}
+		listeners = append(listeners, listener)
+	}
+	return listeners, nil
+}
+
+func closeAll(listeners []net.Listener) {
+	for _, listener := range listeners {
+		_ = listener.Close()
+	}
+}
diff --git a/internal/loopback/listen_test.go b/internal/loopback/listen_test.go
new file mode 100644
index 0000000..047b0b6
--- /dev/null
+++ b/internal/loopback/listen_test.go
@@ -0,0 +1,45 @@
+package loopback
+
+import (
+	"net"
+	"testing"
+)
+
+func TestListenBindsOnlyLocalhostAndSupportsTheRegisteredCallbackHost(t *testing.T) {
+	listeners, err := Listen(0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer closeAll(listeners)
+	if len(listeners) == 0 {
+		t.Fatal("Listen returned no localhost listeners")
+	}
+	port := listeners[0].Addr().(*net.TCPAddr).Port
+	for _, listener := range listeners {
+		address, ok := listener.Addr().(*net.TCPAddr)
+		if !ok || !address.IP.IsLoopback() {
+			t.Fatalf("listener address %v is not loopback", listener.Addr())
+		}
+		if address.Port != port {
+			t.Fatalf("localhost listeners use different ports: %d and %d", port, address.Port)
+		}
+		connection, errDial := net.Dial("tcp", address.String())
+		if errDial != nil {
+			t.Fatalf("cannot reach callback listener at %s: %v", address, errDial)
+		}
+		_ = connection.Close()
+	}
+}
+
+func TestListenFailsClosedWhenACallbackPortIsOccupied(t *testing.T) {
+	listener, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer listener.Close()
+	port := listener.Addr().(*net.TCPAddr).Port
+	if opened, errListen := Listen(port); errListen == nil {
+		closeAll(opened)
+		t.Fatalf("Listen(%d) succeeded while the port was occupied", port)
+	}
+}
